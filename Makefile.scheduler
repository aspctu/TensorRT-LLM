TRTLLM_DEV_CONTAINER ?= trtllm-priority-dev-20260313
TRTLLM_REPO_IN_CONTAINER ?= /code/tensorrt_llm
TRTLLM_BUILD_DIR ?= /tmp/trtllm-build-scheduler
TRTLLM_DIST_DIR ?= /tmp/trtllm-dist
TRTLLM_BUILD_JOBS ?= 32
TRTLLM_CUDA_ARCHITECTURES ?=
TRTLLM_EXTRA_CMAKE_VARS ?=
TRTLLM_CCACHE_DIR ?= /tmp/trtllm-ccache
TRTLLM_CCACHE_MAXSIZE ?= 50G
TRTLLM_SIM_OUTDIR ?= /tmp/trtllm-scheduler-sim
TRTLLM_SIM_JSON ?= $(TRTLLM_SIM_OUTDIR)/scheduler-matrix.json
TRTLLM_SIM_MD ?= $(TRTLLM_SIM_OUTDIR)/scheduler-matrix.md
TRTLLM_SIM_PROFILES ?= premium_protection tier_mix_pressure same_tier_burst premium_noisy_neighbor
TRTLLM_SIM_EXTRA_ARGS ?=

TRTLLM_OPTIONAL_ARCH := $(if $(strip $(TRTLLM_CUDA_ARCHITECTURES)),--cuda_architectures "$(TRTLLM_CUDA_ARCHITECTURES)",)
TRTLLM_CCACHE_CMAKE_VARS := \
	-D "CMAKE_C_COMPILER_LAUNCHER=ccache" \
	-D "CMAKE_CXX_COMPILER_LAUNCHER=ccache" \
	-D "CMAKE_CUDA_COMPILER_LAUNCHER=ccache"
TRTLLM_OPTIONAL_CMAKE_VARS := $(TRTLLM_CCACHE_CMAKE_VARS) $(foreach var,$(TRTLLM_EXTRA_CMAKE_VARS),-D "$(var)")
TRTLLM_CCACHE_ENV := export CCACHE_DIR=$(TRTLLM_CCACHE_DIR) CCACHE_BASEDIR=$(TRTLLM_REPO_IN_CONTAINER) CCACHE_COMPRESS=1 CCACHE_COMPILERCHECK=content PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 TRTLLM_BUILD_SKIP_REQUIREMENTS=1; mkdir -p $(TRTLLM_CCACHE_DIR); ccache -M $(TRTLLM_CCACHE_MAXSIZE) >/dev/null;
TRTLLM_SIM_ARGS := --profiles $(TRTLLM_SIM_PROFILES) --output-json $(TRTLLM_SIM_JSON) --output-markdown $(TRTLLM_SIM_MD) $(TRTLLM_SIM_EXTRA_ARGS)

PYTHON_TESTS = \
	tests/unittest/_torch/executor/test_request_utils.py \
	tests/unittest/_torch/executor/test_waiting_queue.py \
	tests/unittest/_torch/executor/test_scheduler_fairness.py \
	tests/unittest/executor/test_stats_serializer.py

.PHONY: scheduler-wheel
scheduler-wheel:
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc '$(TRTLLM_CCACHE_ENV) cd $(TRTLLM_REPO_IN_CONTAINER) && python3 scripts/build_wheel.py --no-venv --build_dir $(TRTLLM_BUILD_DIR) --dist_dir $(TRTLLM_DIST_DIR) --job_count $(TRTLLM_BUILD_JOBS) $(TRTLLM_OPTIONAL_ARCH) $(TRTLLM_OPTIONAL_CMAKE_VARS)'

.PHONY: scheduler-install-wheel
scheduler-install-wheel:
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc 'python3 -m pip install --force-reinstall --no-deps $$(ls -1t $(TRTLLM_DIST_DIR)/tensorrt_llm-*.whl | head -n1)'

.PHONY: scheduler-build-install
scheduler-build-install: scheduler-wheel scheduler-install-wheel

.PHONY: scheduler-python-tests
scheduler-python-tests:
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc 'cd $(TRTLLM_REPO_IN_CONTAINER) && python3 -m pytest -q $(PYTHON_TESTS)'

.PHONY: scheduler-cpp-test
scheduler-cpp-test:
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc '$(TRTLLM_CCACHE_ENV) cmake --build $(TRTLLM_BUILD_DIR) --target capacitySchedulerTest -j $(TRTLLM_BUILD_JOBS) && $(TRTLLM_BUILD_DIR)/tests/unit_tests/batch_manager/capacitySchedulerTest'

.PHONY: scheduler-sim-matrix
scheduler-sim-matrix:
	mkdir -p $(TRTLLM_SIM_OUTDIR)
	cd $(CURDIR) && python3 scripts/run_scheduler_simulation.py $(TRTLLM_SIM_ARGS)

.PHONY: scheduler-validate
scheduler-validate: scheduler-build-install scheduler-python-tests scheduler-cpp-test scheduler-sim-matrix

.PHONY: scheduler-export-wheel
scheduler-export-wheel:
ifndef DEST
	$(error DEST is required, e.g. make -f Makefile.scheduler scheduler-export-wheel DEST=/tmp/trtllm-wheels)
endif
	mkdir -p $(DEST)
	wheel_name=$$(docker exec $(TRTLLM_DEV_CONTAINER) bash -lc 'basename $$(ls -1t $(TRTLLM_DIST_DIR)/tensorrt_llm-*.whl | head -n1)'); \
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc 'cat $(TRTLLM_DIST_DIR)/'$$wheel_name > $(DEST)/$$wheel_name

.PHONY: scheduler-ccache-stats
scheduler-ccache-stats:
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc '$(TRTLLM_CCACHE_ENV) ccache -s'

.PHONY: scheduler-ccache-zero
scheduler-ccache-zero:
	docker exec $(TRTLLM_DEV_CONTAINER) bash -lc '$(TRTLLM_CCACHE_ENV) ccache -z'
